<header class="border-b border-gray-200 bg-white shadow-sm">
	<div class="mx-auto px-4 py-6 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<h1 class="text-3xl font-bold tracking-tight text-gray-900">Resultados de búsqueda</h1>
				<p class="mt-1 text-sm text-gray-600">
					Noticias relacionadas con <span class="font-medium text-gray-900"><%= params[:query] %></span>
				</p>
			</div>
			<span class="inline-flex w-fit items-center rounded-full bg-indigo-100 px-3 py-1 text-sm font-medium text-indigo-800" role="status">
				<%= @entries.count %> <%= 'noticia'.pluralize(@entries.count) %>
			</span>
		</div>
	</div>
</header>

<%= render 'shared/breadcrumbs', items: [
	{ label: 'Inicio', path: root_path, icon: 'fa-solid fa-home' },
	{ label: 'Búsqueda', path: nil, current: true }
] %>

<main class="min-h-screen bg-gray-50">
	<div class="mx-auto px-4 py-8 sm:px-6 lg:px-8">
		<% if @entries.any? %>
			<div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 xl:gap-x-8">
				<%= render partial: 'entry/entry', collection: @entries, as: :entry, cached: true %>
			</div>
		<% else %>
			<div class="border-2 border-dashed border-gray-300 bg-white px-6 py-12 text-center">
				<i class="fa-solid fa-magnifying-glass text-3xl text-gray-400" aria-hidden="true"></i>
				<h2 class="mt-3 text-lg font-semibold text-gray-900">No se encontraron noticias</h2>
				<p class="mt-1 text-sm text-gray-500">No hay noticias asociadas a esta búsqueda.</p>
			</div>
		<% end %>
	</div>
</main>